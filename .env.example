# CovenX Enterprise Contract Lifecycle Management Platform
# Copy to .env only during local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/covenx
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
SEED_RBAC=false
FRONTEND_URL=http://localhost:5173
