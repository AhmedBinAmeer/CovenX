# CovenX Enterprise Contract Lifecycle Management Platform
# Copy to .env only during local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/covenx
MONGODB_TEST_URI=mongodb://localhost:27017/covenx_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
SEED_RBAC=false
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
STORAGE_PROVIDER=mock
STORAGE_URL_EXPIRY_SECONDS=900
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_PROVIDER=mock
# Intelligence: use mock locally, or set openai plus a server-side API key for governed AI features.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_OUTPUT_TOKENS=6000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Durable outbox and scheduled worker runtime
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_SCHEDULE_INTERVAL_MS=900000
# Generate with: openssl rand -hex 32. Never commit the real key.
INTEGRATION_ENCRYPTION_KEY=
AUDIT_RETENTION_DAYS=2555
DOCUMENT_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=35
